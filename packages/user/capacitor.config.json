{
  "appId": "com.ridingo.user",
  "appName": "Ridingo",
  "webDir": "www",
  "backgroundColor": "#F2F2F7",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "ios": {
    "scheme": "Ridingo",
    "contentInset": "never",
    "backgroundColor": "#F2F2F7"
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F2F2F7",
      "overlaysWebView": true
    }
  }
}
