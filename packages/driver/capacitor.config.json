{
  "appId": "com.ridingo.driver",
  "appName": "Ridingo Driver",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "ios": {
    "scheme": "RidingoDriver",
    "contentInset": "never",
    "backgroundColor": "#000000"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": true
    }
  }
}
